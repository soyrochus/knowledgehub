{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json,hashlib\nfrom pathlib import Path\np=json.loads(Path('run/plan.json').read_text())\ndef short(v):\n if isinstance(v,list): return [short(x) for x in v]\n if not isinstance(v,dict): return v\n if v.get('kind')=='Narrative': return 'Narrative:'+v['value']['fragment']['\"'$ref'\"']\n if set(v)=={'kind','value'}: return {v['kind']:short(v['value'])}\n return {k:short(x) for k,x in v.items() if k\"'!='\"'owners'}\nfor r in p['records']:\n d=r['data']\n if d['kind']=='Element': print(r['key'],json.dumps(short(d['data']['properties']),sort_keys=True))\n elif d['kind'] in ['Assertion','Type','Signature','Baseline','Model']:\n  print(r['key'],json.dumps(short(d['data']),sort_keys=True))\n else:print(r['key'],'KIND',d['kind'],'FIELDS',list(d['data']))\nv=json.loads(Path('run/verification.json').read_text()); g=json.loads(Path('run/generation-manifest.json').read_text())\nfor k in ['baseline','scope','head','destination','catalogue','profile','ontology']: print('MANIFEST MATCH',k,g[k]==v[k])\nfor k,fn in [('plan_digest','plan.json'),('coverage_digest','coverage.json')]:\n b=(Path('run')/fn).read_bytes(); x={'length':len(b),'sha256':hashlib.sha256(b).hexdigest()}\n print('DIGEST MATCH',fn,x==g[k]==v[k],x)\nprint('KEY MAP MATCH',json.loads(Path('run/key-map.json').read_text())==g['key_map'])\nprint('ORIGINAL PATHS',[str(x) for x in Path('run/originals').rglob('*')])\nfor s in json.loads(Path('run/source-manifest.json').read_text()):\n b=(Path('source')/s['input']['path']).read_bytes(); x={'length':len(b),'sha256':hashlib.sha256(b).hexdigest()}\n print('SOURCE HASH',s['input']['key'],x==s['original']==s['input']['expected'],x)\nprint('GENERATION OP KEYS',[list(o) for o in g['known_operations']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
