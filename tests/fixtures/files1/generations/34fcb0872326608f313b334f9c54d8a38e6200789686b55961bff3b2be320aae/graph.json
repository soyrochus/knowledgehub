evision":"121a38a7111afed6740a8d67b0c3046da6605851e33f43d8b089a51c30061b8d"},"interpretation":{"id":"urn:interpretation:atomic-change","revision":"c86a6f5127c5c43463dc8497a8107f4db5864b099c5533715c0c3a84520f3783"},"reference":{"id":"urn:use-case:commit-change-set","revision":"3718e92d929b94b611e33741ee6c37c1f44170be59b18aa09ee1eb47bfd211a3"}}],"id":"34fcb0872326608f313b334f9c54d8a38e6200789686b55961bff3b2be320aae","interpretations":[{"anchor":"atomic-change","interpreter":"host:maintainer","method":"manual source interpretation","reference":{"id":"urn:interpretation:atomic-change","revision":"c86a6f5127c5c43463dc8497a8107f4db5864b099c5533715c0c3a84520f3783"},"source":{"id":"urn:source:ontology","revision":"30cc6f283e2b3f5cea375ff3990c97e4716c918d239ceee1ad331cc57ac06620"},"status":"Authored","text":"The proposed commit use case satisfies the atomic-change requirement. This is authored intent, without review approval or execution evidence."}],"scope":{"branch":"main","hub":"urn:knowledgehub:self-hub","model":"urn:knowledgehub:library","owner":"host:maintainer","profile":{"definitions":[{"kind":"element","reference":{"id":"knowledgehub-seed:Requirement","revision":"7f4f9c168c2a0aa33f3f72824182e1ff43cb73c30908129f1bd377087055c292"},"rules":["title:document:one:nonempty","statement:document:one:nonempty","interpretation:one:authored"]},{"kind":"element","reference":{"id":"knowledgehub-seed:UseCase","revision":"121a38a7111afed6740a8d67b0c3046da6605851e33f43d8b089a51c30061b8d"},"rules":["title:document:one:nonempty","actor:document:one:nonempty","trigger:document:one:nonempty","outcome:document:one:nonempty","interpretation:one:authored"]},{"kind":"relationship","reference":{"id":"knowledgehub-seed:satisfies","revision":"0106dca05300881e98344c5e9950c89afd63b671bc9c4efa56ff297098063aee"},"rules":["from:UseCase:one:exact","to:Requirement:one:exact","endpoints:same-model-snapshot","interpretation:one:authored","elements:zero-or-more-assertions"]},{"kind":"constraint","reference":{"id":"knowledgehub-seed:seed-integrity","revision":"6b11d8a6fcf6e9d571ec9050f7ada99cbd4b4d86a7aa91b0c4292d41e97188ba"},"rules":["identity:unique-per-scope","revisions:immutable:sha256-tagged-canonical-record/1","narrative:one-document-fragment-owner","semantic-fields:graph-owned","source:exact-utf8-byte-range-and-quote","unknown-normative-fields:reject","complete-seed:Requirement-UseCase-satisfies","source:ontology-section-21.4"]}],"ontology":{"id":"urn:source:ontology","revision":"30cc6f283e2b3f5cea375ff3990c97e4716c918d239ceee1ad331cc57ac06620"},"version":"knowledgehub-seed/1"}},"sequence":1,"sources":[{"anchors":[{"end":62457,"id":"atomic-change","quote":"### 21.4 Change sets and consistency guarantees\n\nThe initial atomic commit scope is one model branch. A change set may contain several related operations, such as revising a Markdown-owned definition, updating its structured references, adding a relationship and recording provenance. Multi-model atomic changes are a separate capability and must not be implied by several ordinary commits.\n\nEvery supported backend must preserve these core guarantees:\n\n1. A change set either commits all accepted changes and required metadata or leaves the accepted head unchanged.\n2. Published revisions remain immutable, and a snapshot resolves a consistent set of exact versions.\n3. The operation's expected head and relevant revision guards are checked at commit admission, not merely during an earlier UI or validation pass.\n4. Graph-wide constraints are protected against concurrent changes; independent record checks alone are insufficient where a rule spans several relationships or depends on absence.\n5. The same operation ID, scope, actor and canonical request fingerprint resolve to the original result on retry. Reusing that identity for different intent is rejected.\n6. No durable success acknowledgement is issued before the selected backend's commit/durability contract is fulfilled.\n7. History, provenance, the new head and deduplication result are published coherently. Required change notifications are derived from durable committed records, not emitted as success beforehand.\n\nThe first implementation can serialise writers per model branch and use an expected-head guard. This deliberately favours a clear correctness boundary over fine-grained write concurrency. A future implementation can change its locking strategy while preserving the same observable outcomes.\n\nAfter current access checks, an operation retry consults its deduplication record before treating the original expected head as a new stale write. Returning an existing receipt never re-executes the mutation. A caller that has lost access does not regain it through an old operation ID.\n\nValidation can prepare a commit plan from a coherent base snapshot. The storage adapter applies that plan only if its guards still hold; otherwise the caller must inspect or rebase the change and validate again. The API must not blindly replay a stale user intention against a new head. External source acquisition and other network work occur outside the short commit-publication boundary.\n\n","section":"21.4 Change sets and consistency guarantees","start":60002}],"content":{"bytes":[],"reference":{"length":74064,"sha256":"30cc6f283e2b3f5cea375ff3990c97e4716c918d239ceee1ad331cc57ac06620"}},"reference":{"id":"urn:source:ontology","revision":"30cc6f283e2b3f5cea375ff3990c97e4716c918d239ceee1ad331cc57ac06620"}}]}